<Project Sdk="Microsoft.NET.Sdk">
  <!-- One Native AOT program for every platform: a Win32 window on Windows, a terminal menu elsewhere. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win-'))">WinExe</OutputType>
    <ApplicationManifest Condition="$(RuntimeIdentifier.StartsWith('win-'))">app.manifest</ApplicationManifest>
    <AssemblyName>ZankaiUpdater</AssemblyName>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <!-- Do not require ICU on Linux; nothing here is culture-sensitive. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RulesetUpdater.Core/RulesetUpdater.Core.csproj" />
    <InternalsVisibleTo Include="osu.Game.Rulesets.UpdaterFixture" />
  </ItemGroup>
</Project>
